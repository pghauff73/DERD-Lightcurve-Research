{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xoiam.example/schemas/derd-harmonic-exchange-1.0.json",
  "title": "DERD Harmonic Exchange 1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "canonical_series",
    "object_id",
    "fundamental_frequency",
    "reference_epoch",
    "time_unit",
    "value_unit",
    "harmonic_count",
    "sine_coefficients",
    "cosine_coefficients",
    "source_locator",
    "source_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "DERD-HARMONIC-EXCHANGE-1.0"
    },
    "canonical_series": {
      "const": "y=c0+sum(c_n*exp(i*2*pi*n*f*(t-t0))+conjugate)"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "fundamental_frequency": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reference_epoch": {
      "type": "number"
    },
    "time_unit": {
      "type": "string",
      "minLength": 1
    },
    "value_unit": {
      "type": "string",
      "minLength": 1
    },
    "harmonic_count": {
      "type": "integer",
      "minimum": 1
    },
    "sine_coefficients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "cosine_coefficients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "coefficient_covariance": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "description": "Full covariance matrix ordered as coefficient_covariance_order; excludes intercept."
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    },
    "intercept": {
      "type": "number",
      "description": "Constant term c0 in the canonical series."
    },
    "coefficient_covariance_order": {
      "type": "array",
      "description": "Exact row and column order of coefficient_covariance.",
      "items": {
        "type": "string",
        "pattern": "^(sin|cos)_[1-9][0-9]*$"
      }
    },
    "coefficient_covariance_dimension": {
      "type": "integer",
      "minimum": 2
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "coefficient_covariance"
        ]
      },
      "then": {
        "required": [
          "coefficient_covariance_order",
          "coefficient_covariance_dimension"
        ]
      }
    }
  ]
}
